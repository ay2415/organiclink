# =====================================================================
# ORGANICLINK PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual production credentials.
# DO NOT commit the .env file containing real secrets to version control.
# =====================================================================

# --- General Server Configuration ---
PROJECT_NAME=OrganicLink
ENVIRONMENT=production

# --- Security & JWT Authentication ---
# Generate a fresh 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=da0ab4042a7505feff3511e9bc45ff02a65d66710bbf7f5582441494353503d7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Origin Whitelist ---
# Comma-separated list of allowed web frontend URLs (no trailing slashes)
# Example: http://<YOUR_ORACLE_IP>,https://organiclink.ie,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=organiclink
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=organiclink_db
DATABASE_URL=postgresql://organiclink:your_strong_postgres_password_here@postgres:5432/organiclink_db

# --- Platform Business Rules ---
VARIANCE_TOLERANCE_PERCENT=10.0
MIN_LISTING_GRADE=C
COMMISSION_PERCENT=5.0
PAYMENT_TERMS_DAYS=14
