# =====================================================================
# ORGANICLINK PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your server and fill in your actual credentials.
# DO NOT commit the .env file containing real secrets to version control.
# =====================================================================

# --- General Server Configuration ---
PROJECT_NAME=OrganicLink
ENVIRONMENT=production

# --- Initial Administrator Account Setup ---
# Used by: python -m seed.create_admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChooseAStrongAdminPassword123!
ADMIN_NAME=Platform Administrator

# --- Security & JWT Authentication ---
# Generate a fresh 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64_character_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS Origin Whitelist ---
# Comma-separated list of allowed web frontend URLs (no trailing slashes)
# Example: http://<YOUR_AZURE_VM_PUBLIC_IP>,http://localhost:80,http://localhost
ALLOWED_ORIGINS=http://localhost:80,http://localhost

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=organiclink
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=organiclink_db
DATABASE_URL=postgresql://organiclink:your_secure_postgres_password_here@postgres:5432/organiclink_db

# --- Platform Business Rules ---
VARIANCE_TOLERANCE_PERCENT=10.0
MIN_LISTING_GRADE=C
COMMISSION_PERCENT=5.0
PAYMENT_TERMS_DAYS=14
